{
  "name": "samba-dc-controller",
  "productName": "Samba Domain Controller Controller",
  "version": "2.0.0",
  "description": "A simple graphical interface for managing a Samba Active Directory domain controller over SSH using samba-tool",
  "license": "GPL-3.0-only",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "dist": "npm run build && electron-builder",
    "fake-dc": "esbuild test/fake-dc/main.ts --bundle --platform=node --log-level=warning --external:cpu-features --outfile=dist/fake-dc.js && node dist/fake-dc.js",
    "e2e": "npm run build && esbuild test/e2e/smoke.ts --bundle --platform=node --log-level=warning --external:playwright-core --external:cpu-features --outfile=dist/e2e.js && node dist/e2e.js"
  },
  "build": {
    "appId": "io.github.claude-coder-collab.sdcc",
    "productName": "Samba Domain Controller Controller",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "design/SDCC.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "design/SDCC.iconset/icon_512x512@2x.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "icon": "design/SDCC.iconset/icon_512x512@2x.png"
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/ssh2": "^1.15.6",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "playwright-core": "^1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "repository": "github:claude-coder-collab/Samba-Active-Directory-Domain-Controller-Controller",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
